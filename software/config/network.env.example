# ==============================================================================
# Dorsett Network Configuration Example
# ==============================================================================
# Copiar a /etc/dorsett/network.env en la Raspberry Pi 5 y proteger con:
#   sudo chown root:root /etc/dorsett/network.env
#   sudo chmod 0600 /etc/dorsett/network.env
#
# REGLAS DE SEGURIDAD Y SINTAXIS:
# - NO incluir contraseñas Wi-Fi (PSK) ni secretos en este archivo.
# - Usar comillas dobles si el nombre de un perfil contiene espacios.
# - Este archivo se parsea como pares CLAVE=VALOR (sin eval ni ejecución shell).
# ==============================================================================

# Interfaz Wi-Fi administrada por NetworkManager
WIFI_INTERFACE=wlan0

# Nombre exacto del perfil doméstico en NetworkManager (prioridad 100)
# Ejemplo en Debian/Netplan: "netplan-wlan0-MiRedDomestica"
HOME_PROFILE="home-profile"

# Nombre exacto del perfil del hotspot móvil en NetworkManager (prioridad 50)
MOBILE_PROFILE="mobile-profile"

# Perfil y SSID para el Access Point autónomo (modo NOMAD)
AP_PROFILE="Dorsett-AP"
AP_SSID="Dorsett-AP"

# Direccionamiento IPv4 CIDR del modo NOMAD (ipv4.method shared + dnsmasq)
AP_ADDRESS=10.42.0.1/24

# Banda Wi-Fi (bg = 2.4 GHz recomendada para compatibilidad con Tablet Win 8.1)
AP_BAND=bg

# Canal Wi-Fi inicial para Dorsett-AP (1, 6 u 11 recomendados en 2.4 GHz)
AP_CHANNEL=6

# Ventana inicial (segundos) de espera al arrancar antes de activar fallback AP
FALLBACK_TIMEOUT=30

# Temporizador (segundos) de recuperación automática para cambios remotos por SSH
ROLLBACK_TIMEOUT=120

# Límite temporal (segundos) por operación individual de nmcli
NMCLI_TIMEOUT=20

# Archivo de bloqueo para evitar ejecuciones concurrentes
LOCK_FILE=/run/dorsett-network.lock
